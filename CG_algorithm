# --- PLOTTING DEL 2: KONVERGENSKURVOR ---
def plot_convergence(obj_hist, rel_res_hist, rre_hist, title):
    print("Objective histories:", len(obj_hist))
    print("Residual histories:", len(rel_res_hist))
    print("RRE histories:", len(rre_hist))
    fix, axs = plt.subplots(1, 3, figsize=(10, 4))
    #plt.suptitle(title, fontsize=16)
    # Plot 1: Objektfunktionen
    for i in range(0,len(obj_hist)):
        axs[0].plot(obj_hist[i], color = (['orange', 'green', 'blue'][i]), linewidth = 2, label =(["a","b","c"][i]), linestyle = ([":", "-", "--"][i]))
        # 2. Plot the last value as a dot
        last_x = len(obj_hist[i]) - 1
        last_y = obj_hist[i][-1]
        axs[0].plot(last_x, last_y, marker='o', color=['orange', 'green', 'blue'][i])
    #axs[0].plot(obj_hist[0], color='orange', linewidth=2)
    #axs[0].plot(obj_hist[1], color='green', linewidth=2)
    #axs[0].plot(obj_hist[2], color='blue', linewidth=2)
    axs[0].set_title('Objective Function\n'r'$\|Ax-b\|_2^2 + \lambda^2\|Lx\|_2^2$')
    axs[0].set_xlabel('Iteration ($k$)')
    axs[0].set_ylabel('Log Scale Value')
    axs[0].set_yscale('log')
    axs[0].grid(True, which="both", ls="--")
    axs[0].legend()
    

    # Plot 2: Relativ Residual
    #axs[1].plot(rel_res_hist[0], color='orange', linewidth=2)
    #axs[1].plot(rel_res_hist[1], color='green', linewidth=2)
    #axs[1].plot(rel_res_hist[2], color='blue', linewidth=2)
    for i in range(0,len(rel_res_hist)):
        axs[1].plot(rel_res_hist[i], color = (['orange', 'green', 'blue'][i]), linewidth = 2, label =(["a","b","c"][i]), linestyle = ([":", "-", "--"][i]))
        last_x = len(rel_res_hist[i]) - 1
        last_y = rel_res_hist[i][-1]
        axs[1].plot(last_x, last_y, marker='o', color=['orange', 'green', 'blue'][i])
    axs[1].set_yscale('log')
    axs[1].set_title('Relative Residual of Normal Eqs\n'r'$\|C x^{(k)} - D\|_2 / \|D\|_2$')
    axs[1].set_xlabel('Iteration ($k$)')
    axs[1].set_ylabel('Log Scale Value')
    axs[1].set_yscale('log')
    axs[1].grid(True, which="both", ls="--")
    axs[1].legend()
    

    # Plot 3: Relativt Rekonstruktionsfel (RRE)
    #axs[2].plot(rre_hist[0], color='orange', linewidth=2)
