        axs[2].plot(rre_hist[i], color = (['orange', 'green', 'blue'][i]), linewidth = 2, label =(["a","b","c"][i]), linestyle = ([":", "-", "--"][i]))
        last_x = len(rre_hist[i]) - 1
        last_y = rre_hist[i][-1]
        axs[2].plot(last_x, last_y, marker='o', color=['orange', 'green', 'blue'][i])
    axs[2].set_title('Relative Reconstruction Error (RRE)\n'r'$\|x_{true} - x^{(k)}\|_2 / \|x_{true}\|_2$')
    axs[2].set_xlabel('Iteration ($k$)')
