# CG algorithm updated for tracking history
def CG(C_op, D, x0, A, L, b, x_true, lam, tol=1e-5, max_iter=1000):
    r = D - C_op @ x0
    p = r.copy()
    x = x0.copy()
    ro = r.T @ r
    iterations = 0

    # Förbered listor för att spara historik för varje iteration
    obj_history = []
    rel_res_history = []
    rre_history = []

    norm_D = np.linalg.norm(D)
    norm_xtrue = np.linalg.norm(x_true)

    while iterations < max_iter:
        # --- BERÄKNA METRIKER FÖR DENNA ITERATION ---
        # 1. Objektfunktionen: ||Ax - b||^2 + lambda^2 * ||Lx||^2
        Ax = A @ x
        Lx = L @ x
        obj_history.append(np.linalg.norm(Ax - b) ** 2 + (lam ** 2) * np.linalg.norm(Lx) ** 2)

        # 2. Relativ residual för de normala ekvationerna: ||C*x - D|| / ||D||
        # (Använder r = D - C*x som redan är beräknat eller uppdaterat)
        rel_res = np.linalg.norm(r) / norm_D
        rel_res_history.append(rel_res)

        # 3. Relativt rekonstruktionsfel (RRE): ||x_true - x|| / ||x_true||
        rre = np.linalg.norm(x_true - x) / norm_xtrue
        rre_history.append(rre)

        # --- STANDARD CG UPPDATERING ---
        q = C_op @ p
        alpha = ro / (p.T @ q)
        x = x + alpha * p 
        r = r - alpha * q

        # Kolla konvergens mot toleransen
        if np.linalg.norm(r) / norm_D <= tol:
            # Spara sista värdena innan vi bryter
            obj_history.append(np.linalg.norm(A @ x - b) ** 2 + (lam ** 2) * np.linalg.norm(L @ x) ** 2)
            rel_res_history.append(np.linalg.norm(r) / norm_D)
            rre_history.append(np.linalg.norm(x_true - x) / norm_xtrue)
            iterations += 1
            break
            
        ro_new = r.T @ r
        beta = ro_new / ro
        p = r + beta * p

        ro = ro_new
        iterations += 1

    residual = r  # r motsvarar D - C @ x efter loopen
    
    # Returnera historik-listorna också så att vi kan plotta dem
    return x, iterations, residual, obj_history, rel_res_history, rre_history

def apply_C(v,lam):
        return A.T @ (A @ v) + lam**2 * (L.T @ (L @ v))

